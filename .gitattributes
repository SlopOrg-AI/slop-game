# Normalise line endings to LF for every text file (agents, Godot, GDScript, JSON all expect LF).
* text=auto eol=lf

# Explicit text types
*.md   text eol=lf
*.json text eol=lf
*.gd   text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.html text eol=lf
*.py   text eol=lf
*.cfg  text eol=lf
*.godot text eol=lf

# Binary — never touch
*.png  binary
*.jpg  binary
*.webp binary
*.ogg  binary
*.wav  binary
*.ttf  binary
