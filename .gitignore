# D5.28 - art binaries: contact sheets and *selected* boards only; raw
# generations stay local. Already-committed PNGs are left in history (no
# rewrite); which of those are keepers is Art/Content's call, not git's.
proposals/art/**/*.png
!proposals/art/**/_contact-sheet.png
!proposals/art/**/accepted/**

# Python
__pycache__/
*.pyc

# Local copies of tools/claude-agents/ (that folder is the source of truth).
.claude/agents/
