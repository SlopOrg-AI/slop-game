      "baseline": 0,
      "min": -5,
      "max": 5,
      "tick": 0
    },
    "time_of_day": {
      "baseline": 0,
      "min": -5,
      "max": 5,
      "tick": 0
    }
  },
  "tipping_threshold": 4,
