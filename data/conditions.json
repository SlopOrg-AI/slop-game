{
  "_doc": "Scene condition tracks — bible §10.1. Baseline + increments; ±1 normal; +4 tipping. Each declares its own tick. Cascades push each other; depth ≤ 2 per round. MVP authors footing and light only.",
  "schema_version": 2,
  "scene_conditions": {
    "light": {
      "baseline": 0,
      "min": -5,
      "max": 5,
      "tick": 0
    },
    "noise": {
      "baseline": 0,
      "min": -5,
      "max": 5,
      "tick": -1
    },
    "alert": {
      "baseline": 0,
      "min": 0,
      "max": 5,
      "tick": 0
    },
    "footing": {
      "baseline": 0,
      "min": -5,
      "max": 5,
      "tick": 0
    },
